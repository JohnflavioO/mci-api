# Configurações privadas de frete — somente Environment Variables server-side da Vercel.
# Nunca usar prefixo VITE_ e nunca versionar valores reais.

SHIPPING_ORIGIN_CEP=88313000
SHIPPING_SENDER_CNPJ=05502390000200

PICKUP_ENABLED=true
PICKUP_NAME=Armazém Sanco
PICKUP_ADDRESS=
PICKUP_INSTRUCTIONS=

# Correios CWS — preencher com os dados do portal/contrato.
CORREIOS_ENABLED=false
CORREIOS_API_BASE_URL=https://api.correios.com.br
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CARTAO_POSTAGEM=
CORREIOS_CONTRATO=
CORREIOS_DR=
# Códigos reais dos serviços habilitados no contrato, separados por vírgula.
CORREIOS_SERVICE_CODES=

# Jamef — manter Sandbox durante desenvolvimento e homologação.
JAMEF_ENABLED=false
JAMEF_ENVIRONMENT=sandbox
JAMEF_API_BASE_URL=
JAMEF_USERNAME=
JAMEF_PASSWORD=
