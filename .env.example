# Configurações privadas do frete — somente no ambiente server-side (Vercel).
# Nunca usar prefixo VITE_ nestas variáveis.

SHIPPING_ORIGIN_CEP=88313000
SHIPPING_SENDER_CNPJ=05502390000200

# Retirada no local
PICKUP_ENABLED=true
PICKUP_NAME=Armazém Sanco
PICKUP_ADDRESS=
PICKUP_INSTRUCTIONS=

# Correios — exige token válido e códigos de serviço habilitados no contrato.
CORREIOS_ENABLED=false
CORREIOS_API_BASE_URL=https://api.correios.com.br
CORREIOS_TOKEN=
CORREIOS_SERVICE_CODES=
CORREIOS_CONTRACT_NUMBER=
CORREIOS_CONTRACT_DR=

# Jamef — iniciar exclusivamente no Sandbox.
JAMEF_ENABLED=false
JAMEF_ENVIRONMENT=sandbox
JAMEF_API_BASE_URL=
JAMEF_USERNAME=
JAMEF_PASSWORD=
