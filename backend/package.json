{
  "name": "mci-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:integration": "NODE_ENV=test node --import tsx --test --test-concurrency=1 test/integration/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "oracledb": "^6.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/oracledb": "^6.5.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}