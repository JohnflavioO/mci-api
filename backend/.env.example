# Copie para .env (nunca versionar o .env)
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Origens do frontend permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:8080

# Oracle Autonomous Database
DB_USER=
DB_PASSWORD=
# Alias do tnsnames.ora (ex.: mcidb_high) ou connect string completa
DB_CONNECT_STRING=
# Pasta do wallet descompactado (necessário para mTLS)
DB_WALLET_DIR=
DB_WALLET_PASSWORD=
